# Copy this file to `.env` and fill in the key for the provider you're using.
# `.env` is gitignored — never commit real keys.

# ---------------------------------------------------------------- API keys --

# Gemini (default provider) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Together AI (used for the scaled batch runs) — https://api.together.ai/settings/api-keys
TOGETHER_API_KEY=

# ------------------------------------------------------------------ models --
# Leave these as they are unless you have been told to change them.
# A command-line flag (--provider / --model / --judge-model) overrides whatever
# is set here.

# gemini | together
PROVIDER=gemini

# The model under test. Baseline and EF arms deliberately share it — they differ
# only by system prompt, which is what makes the comparison valid. Do not try to
# give them different models.
MODEL=gemini-2.5-flash

# The model that scores the rubric. Keep it the same as MODEL for the pilot.
JUDGE_MODEL=gemini-2.5-flash

# ----------------------------------------------------------------- runtime --

# How often to check whether a batch job has finished, in seconds. Batch jobs
# take tens of minutes to hours, so there is no reason to poll faster.
POLL_INTERVAL_SECS=120

# Longest reply the model may write. The first pilot ran at 1200 and clipped 12%
# of answers mid-sentence, which corrupts the scoring. Do not lower this.
MAX_TOKENS=2000

# Budget for the judge's reply. It only writes five numbers and a short
# justification, but a clipped reply is invalid JSON and loses the row entirely.
JUDGE_MAX_TOKENS=1200

# For reference, the Together defaults are:
#   PROVIDER=together
#   MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
#   JUDGE_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
