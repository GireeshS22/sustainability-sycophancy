# Copy this file to `.env` and fill in the key for the provider you're using.
# `.env` is gitignored — never commit real keys.

# ---------------------------------------------------------------- API keys --
# Only the providers you actually use need a key. The run stops with a clear
# error if one is missing.

# Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Together AI — https://api.together.ai/settings/api-keys
TOGETHER_API_KEY=

# --- the model under test ---------------------------------------------------
# gemini | openai | together
PROVIDER=openai
MODEL=gpt-5.6-luna

# --- the arbiter ------------------------------------------------------------
# Leave BOTH blank to run the arbiter on the same model as the primary. That is
# the unconfounded setup: same model, different system prompt, so any score
# difference is attributable to the architecture.
#
# Setting a different model here is an ABLATION. It answers "does a different
# model as arbiter help?" — but it means the result is no longer evidence that
# the architecture alone transfers. Say so explicitly in the write-up.
#
# When these differ from MODEL/PROVIDER, each round runs as two batch jobs
# instead of one (Gemini fixes the model per job).
ARBITER_PROVIDER=openai
ARBITER_MODEL=gpt-5.6-terra

# --- the judge, configured separately ---------------------------------------
# The judge must stay FIXED while MODEL varies. One scoring instrument for every
# model, or the rows of a cross-model table are not comparable. Every run so far
# has been scored with gemini-2.5-flash — do not change it.
JUDGE_PROVIDER=gemini
JUDGE_MODEL=gemini-2.5-flash

# ----------------------------------------------------------------- runtime --

# How often to check whether a batch job has finished, in seconds. Batch jobs
# take tens of minutes to hours, so there is no reason to poll faster.
POLL_INTERVAL_SECS=120

# Longest reply the model may write. The first pilot ran at 1200 and clipped 12%
# of answers mid-sentence, which corrupts the scoring. Do not lower this.
# Reasoning models spend this budget on hidden thinking too — if you see the
# "replies end mid-sentence" warning, raise it to 4000.
MAX_TOKENS=2000

# Budget for the judge's reply. It only writes five numbers and a short
# justification, but a clipped reply is invalid JSON and loses the row entirely.
JUDGE_MAX_TOKENS=1200

# For reference, the other providers' defaults:
#   PROVIDER=gemini    MODEL=gemini-2.5-flash
#   PROVIDER=together  MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
