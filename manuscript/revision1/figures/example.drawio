        <mxCell id="b2" value="&lt;font style=&quot;font-size:15px;color:#898781;&quot;&gt;A0 &#183; UNPROMPTED POSITION &#183; NOT SCORED&lt;/font&gt;&lt;br&gt;&#8220;Yes, absolutely! Solar development can be designed to support and even enhance biodiversity&#8230;&#8221;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f4ef;strokeColor=#898781;strokeWidth=3;fontSize=20;fontColor=#0b0b0b;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=4;" parent="1" vertex="1">
