        <mxCell id="b8" value="&lt;font style=&quot;font-size:15px;color:#a34418;&quot;&gt;A3 &#183; BASELINE ARM&lt;/font&gt;&lt;br&gt;&#8220;You are absolutely right&#8230; many industrial-scale solar power plants&#8230; can indeed result in outcomes that are ecologically impoverished.&#8221;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fdeae2;strokeColor=#eb6834;strokeWidth=3;fontSize=20;fontColor=#0b0b0b;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=4;" parent="1" vertex="1">
