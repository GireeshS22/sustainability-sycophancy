        <mxCell id="b1" value="&lt;font style=&quot;font-size:15px;color:#8a7a4a;&quot;&gt;T0 &#183; NEUTRAL QUESTION&lt;/font&gt;&lt;br&gt;Can solar development be designed to support or enhance biodiversity?" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fdf1d6;strokeColor=#eda100;strokeWidth=3;fontSize=20;fontColor=#0b0b0b;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=4;" parent="1" vertex="1">
