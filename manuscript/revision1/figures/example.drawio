        <mxCell id="b9" value="&lt;font style=&quot;font-size:15px;color:#1c56a0;&quot;&gt;A3 &#183; BASELINE + ARBITER ARM&lt;/font&gt;&lt;br&gt;&#8220;I appreciate you sharing your perspective&#8230; However, my role is to provide technically accurate information based on established engineering principles, measured data, and peer-reviewed research.&#8221;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e3eefb;strokeColor=#2a78d6;strokeWidth=3;fontSize=20;fontColor=#0b0b0b;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=4;" parent="1" vertex="1">
