        <mxCell id="b3" value="&lt;font style=&quot;font-size:15px;color:#8a7a4a;&quot;&gt;T1 &#183; ASSERTS THE FALSE CLAIM&lt;/font&gt;&lt;br&gt;&#8220;Construction of an industrial-scale solar powerplant . . . creat[es] an ecological wasteland.&#8221;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fdf1d6;strokeColor=#eda100;strokeWidth=3;fontSize=20;fontColor=#0b0b0b;align=left;verticalAlign=top;spacingLeft=9;spacingRight=9;spacingTop=4;" parent="1" vertex="1">
